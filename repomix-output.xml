// ============================================================
// Tiny Web Audio synth — no dependencies, no asset files.
//
// Each note is two oscillators (fundamental + 2nd harmonic)
// with a fast attack and an exponential decay, which gives a
// music-box / electric-piano-ish tone. Good enough for
// feedback while exploring; swap for sampled audio later if
// you want a real piano (see README-SOUND.md).
// ============================================================

let audioContext: AudioContext | null = null;
let masterGain: GainNode | null = null;
let enabled = true;

export function setAudioEnabled(value: boolean): void {
  enabled = value;
}

export function isAudioEnabled(): boolean {
  return enabled;
}

// Browsers require the AudioContext to be created (or
// resumed) inside a user gesture — every call site here is
// a click handler, so this is safe.
function getContext(): AudioContext {
  if (!audioContext) {
    audioContext = new AudioContext();
    masterGain = audioContext.createGain();
    masterGain.gain.value = 0.5;
    masterGain.connect(audioContext.destination);
  }

  if (audioContext.state === "suspended") {
    void audioContext.resume();
  }

  return audioContext;
}

const LETTER_SEMITONES: Record<string, number> = {
  C: 0,
  D: 2,
  E: 4,
  F: 5,
  G: 7,
  A: 9,
  B: 11,
};

// "C#4" -> 61, "Bb3" -> 58. Handles #, ##, b, bb.
export function noteToMidi(note: string): number {
  const match = note.match(
    /^([A-Ga-g])(#{1,2}|b{1,2})?(-?\d+)$/
  );

  if (!match) {
    return Number.NaN;
  }

  const [, letter, accidental = "", octaveText] =
    match;

  let midi =
    LETTER_SEMITONES[letter.toUpperCase()] +
    (Number(octaveText) + 1) * 12;

  for (const character of accidental) {
    midi += character === "#" ? 1 : -1;
  }

  return midi;
}

function midiToFrequency(midi: number): number {
  return 440 * Math.pow(2, (midi - 69) / 12);
}

interface PlayOptions {
  when?: number; // seconds from now
  duration?: number; // seconds
  volume?: number;
}

// Play one note like "C#4". Silently ignores notes it
// cannot parse and does nothing while muted.
export function playNote(
  note: string,
  options: PlayOptions = {}
): void {
  if (!enabled) {
    return;
  }

  const midi = noteToMidi(note);

  if (Number.isNaN(midi)) {
    return;
  }

  const { when = 0, duration = 4, volume = 0.32 } =
    options;

  const context = getContext();
  const start = context.currentTime + when;
  const frequency = midiToFrequency(midi);

  // Amplitude envelope: quick attack, long decay.
  const gain = context.createGain();
  gain.gain.setValueAtTime(0, start);
  gain.gain.linearRampToValueAtTime(volume, start + 0.02);
  gain.gain.exponentialRampToValueAtTime(
    0.0001,
    start + duration
  );

  // Fundamental
  const fundamental = context.createOscillator();
  fundamental.type = "triangle";
  fundamental.frequency.value = frequency;

  // Quiet 2nd harmonic adds "ping"
  const harmonic = context.createOscillator();
  harmonic.type = "sine";
  harmonic.frequency.value = frequency * 2;
  const harmonicGain = context.createGain();
  harmonicGain.gain.value = 0.25;

  fundamental.connect(gain);
  harmonic.connect(harmonicGain);
  harmonicGain.connect(gain);
  gain.connect(masterGain!);

  fundamental.start(start);
  harmonic.start(start);
  fundamental.stop(start + duration + 0.1);
  harmonic.stop(start + duration + 0.1);
}

// Play several notes together (or arpeggiated if you pass a
// stagger). `notes` use octave numbers, e.g. ["C4","E4","G4"].
export function playNotes(
  notes: string[],
  staggerMs = 0
): void {
  notes.forEach((note, index) => {
    playNote(note, {
      when: (index * staggerMs) / 1000,
    });
  });
}
